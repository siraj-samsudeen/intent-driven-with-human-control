# Default schema for new changes = build mode. Each change picks its mode when it is created
# (CLAUDE.md § Modes); its own .openspec.yaml records the schema it was created with:
#   autopilot:        openspec new change <name> --schema intent-driven
#   build / learning: openspec new change <name>     (intent-driven-with-human-control)
schema: intent-driven-with-human-control
stack: {{ acceptance_stack }}

# context: |   # injected into every artifact's instructions, sub-agents included; fill in per project
#   Tech stack: <runtime, framework, test runner>. Everything else arrives with the test that needs it.
#   Domain: <what is being built>.

# rules and operations apply to every change, whatever its schema. A line that applies to one
# mode only says so first ("Autopilot only - ...") and is keyed on the change's schema, which
# `openspec status --change <name>` prints.
rules:
  proposal:
    - Make the first line of proposal.md the mode - `**Mode:** autopilot`, `**Mode:** build` or `**Mode:** learning` - as chosen when the change was created (CLAUDE.md § Modes). Autopilot changes use the intent-driven schema; build and learning use intent-driven-with-human-control
    - Must use grill-me skill - one decision per question, showing the text it will write into the artifact (paraphrased is fine), with the alternatives
    # - Must use adversarial-authoring skill - only with the human's consent (AGENTS.md § Review guidelines)
    # - Must use glossary skill
  design:
    - Must use grill-me skill - one decision per question, showing the text it will write into the artifact (paraphrased is fine), with the alternatives
    - Must use c4-diagrams skill - Mermaid, lightweight C4-inspired; do not ask
    # - Must use glossary skill
  adr:
    - Must use grill-me skill - one decision per question, showing the text it will write into the artifact (paraphrased is fine), with the alternatives
    - Must use architectural-decision-records skill
  specs:
    - Must use grill-me skill - one decision per question, showing the text it will write into the artifact (paraphrased is fine), with the alternatives
    - Autopilot only (schema intent-driven) - Must use spec-as-source skill
  tasks:
    - Must use grill-me skill - one decision per question, showing the text it will write into the artifact (paraphrased is fine), with the alternatives
    - Autopilot only (schema intent-driven) - Must use spec-as-source skill

operations:
  apply:
    guidance:
      - Must use test-driven-development skill
      - Autopilot only (schema intent-driven) - use the senior-qa sub-agent for acceptance tests and the senior-dev sub-agent for all src work, acceptance tests first. Do not batch the tasks to save calls; call them as many times as needed in small batches, as dev and qa work may interleave. Several changes may run in parallel worktrees with the openspec-bulk-apply-change skill
      - Build and learning (schema intent-driven-with-human-control) - follow the schema's apply instruction (outside-in-tdd skill); do the work in the main session, never hand it to sub-agents
  archive:
    guidance:
      - Must run OpenSpec Sync before archiving
